{
    "name": "lucyddeck",
    "author": "Lucyd",
    "description": "An open-source, low-cost alternative to commercial stream decks.",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "build": "vue-tsc && vite build",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dist": "electron-builder --config config/electron-builder.json --win --linux --x64",
        "dist:win": "electron-builder --config config/electron-builder.json --win --x64",
        "dist:linux": "electron-builder --config config/electron-builder.json --linux --x64"
    },
    "dependencies": {
        "crc": "^4.3.2",
        "node-hid": "^3.1.2",
        "serialport": "^13.0.0",
        "vue": "^3.4.21"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^9.39.5",
        "@vitejs/plugin-vue": "^5.0.4",
        "commitlint": "^20.5.3",
        "electron": "^30.0.1",
        "electron-builder": "^24.13.3",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^5.1.6",
        "vite-plugin-electron": "^0.28.6",
        "vite-plugin-electron-renderer": "^0.14.5",
        "vue-tsc": "^2.0.26"
    },
    "main": "dist-electron/main.js"
}
