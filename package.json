{
    "name": "lucyddeck",
    "author": "Lucyd",
    "description": "An open-source, low-cost alternative to commercial stream decks.",
    "private": true,
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucyd-dev/LucydDeck.git"
    },
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "build": "vue-tsc && vite build",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "dist": "electron-builder --config config/electron-builder.json --win --linux --x64",
        "dist:win": "electron-builder --config config/electron-builder.json --win --x64",
        "dist:linux": "electron-builder --config config/electron-builder.json --linux --x64"
    },
    "dependencies": {
        "node-hid": "^3.4.0",
        "sharp": "^0.34.5",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^10.0.1",
        "@lucide/vue": "^1.46.0",
        "@types/node": "^26.5.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "commitlint": "^20.5.3",
        "electron": "^44.3.0",
        "electron-builder": "^26.16.1",
        "electron-log": "^5.4.4",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "pinia": "^4.0.3",
        "prettier": "^3.9.6",
        "sass": "^1.104.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-plugin-electron": "^1.1.2",
        "vitest": "^5.0.0",
        "vue-router": "^5.3.1",
        "vue-tsc": "^3.3.11"
    },
    "main": "dist-electron/main.js",
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "electron@44.3.0": true,
        "electron-winstaller@5.4.0": true,
        "node-hid@3.4.0": true,
        "sharp@0.34.5": true
    }
}
