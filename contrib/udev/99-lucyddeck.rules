# LucydDeck: ESP32-S3 native USB
# Gives the WSL user access to the deck's HID interface and its CDC serial port.
# Install with:
#   sudo cp contrib/udev/99-lucyddeck.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="303a", MODE="0666"
KERNEL=="ttyACM*", ATTRS{idVendor}=="303a", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="303a", MODE="0666"
